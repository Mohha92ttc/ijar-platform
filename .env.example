# Public app URL (emails, Stripe redirects)
APP_URL="http://localhost:5173"

# Database
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="ijar_db"
DB_USER="postgres"
DB_PASSWORD="password"

# Email — required in production
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@ijar.iq"

# Server
PORT="5173"
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Security — JWT_SECRET ≥ 32 random chars (required)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BCRYPT_ROUNDS=12
ENABLE_MOCK_AUTH="false"

# Stripe (optional). Webhook: POST /api/payments/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="usd"
STRIPE_SUCCESS_URL=""
STRIPE_CANCEL_URL=""

# Object Storage S3-compatible (AWS / R2 / MinIO). If unset → local ./uploads
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""
S3_PREFIX="proofs"
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_ACL="false"

# Backups
BACKUP_DIR="./backups"
BACKUP_KEEP_DAYS="14"

# Optional SMS / push
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_PHONE_NUMBER=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
GEMINI_API_KEY=""
